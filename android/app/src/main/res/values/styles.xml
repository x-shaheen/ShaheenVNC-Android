<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.KasmVNC" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/md_theme_light_primary</item>
        <item name="android:colorPrimaryDark">@color/md_theme_light_primary</item>
        <item name="android:colorAccent">@color/md_theme_light_primary</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.KasmVNC.Fullscreen" parent="Theme.KasmVNC">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
